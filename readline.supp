{
    leak_readline
    Memcheck:Leak
    match-leak-kinds: reachable,possible,definite
    fun:malloc
    ...
    fun:readline
}
{
    leak_readline
    Memcheck:Leak
    match-leak-kinds: reachable,possible,definite
    fun:realloc
    ...
    fun:readline
}
{
    leak_readline
    Memcheck:Leak
    match-leak-kinds: reachable,possible,definite
    fun:calloc
    ...
    fun:readline
}
{
    leak add_history
    Memcheck:Leak
    ...
    fun:add_history
}
